#!/usr/bin/env bash
# Pre-push Git hook for Totto, Mercedes F1 Fan Agent (totto_mercedes_f1_agent).
# Enforces all 5 Defined CXAS & > 90% Evaluation Gates (scripts/pre_push_gate.sh and scripts/run_defined_gates.py).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || (cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd))"
cd "${REPO_ROOT}"

exec "${REPO_ROOT}/scripts/pre_push_gate.sh"
